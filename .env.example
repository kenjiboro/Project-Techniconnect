# Supabase Environment Variables
# Copy this to .env and fill in your values from Supabase Project Settings > API

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SESSION_SECRET=techniconnect-change-in-production

# Email / SMTP (for approval & rejection notifications)
# Leave blank to disable emails during local development
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=noreply@cit.edu
MAIL_PASS=your-app-password
MAIL_FROM=TechniConnect <noreply@cit.edu>
APP_URL=http://localhost:3000

# Campus gate scanner
GATE_SCANNER_KEY=change-this-long-random-string
# Staff email(s) alerted on each gate entry (comma-separated). Leave blank for in-app alerts only.
GATE_ALERT_EMAIL=admin@cit.edu